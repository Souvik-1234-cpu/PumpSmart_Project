# =============================================================================
# src/module_12_stage1_steps2_3_4_foundation.py
#
# M12 Stage 1 — Steps 1.2, 1.3, 1.4 (sequential pipeline)
#
# PURPOSE
#   Three tightly inter-dependent deliverables run in strict order.
#   Each stage gate aborts the script on failure — no error propagation.
#
#   STEP 1.2 — Export M6.5r z_t PCA
#     Re-runs M4 encoder over M6B sequences to reconstruct the z_t pool,
#     fits a PCA(n_components=2) identical to M6.5r training-time computation,
#     and saves:
#       models/M6p5r_zt_pca.pkl   — sklearn PCA object
#       models/M6p5r_zt_mean.npy  — mean vector for z_t centering
#     Gate: PCA round-trip reproduces z_t_pca_1, z_t_pca_2, z_t_norm,
#           z_t_recon_err within 1e-5 on a held-out z_t sample.
#
#   STEP 1.3 — Create app/runtime/feature_builder.py
#     Writes the single source of truth for the 33-feature M7 input vector.
#     Class A (indices 0-15): per-channel M4 reconstruction MAE + log1p
#     Class B (indices 16-19): z_t PCA features via saved M6p5r_zt_pca.pkl
#     Class C (indices 29-31): score_A, score_B, score_C direct pass-through
#     Class D (indices 20-28, 32): stubbed 0.0 — Stage 2 fills these
#     Gate: Class A + B (indices 0-19) bit-exact identity vs
#           M6B_feature_matrix.csv within 1e-5 for 20 sample windows.
#
#   STEP 1.4 — Startup self-test patch for model_registry.py
#     Writes app/runtime/feature_builder_selftest.py — a standalone module
#     that model_registry.load_all_models() calls at server startup.
#     Runs the same 20-window identity check; aborts startup on mismatch.
#     Gate: self-test passes on clean env; simulated mismatch triggers abort.
#
# IMPORTANT
#   This script is a RE-RUN, not a retrain.
#   M4 checkpoint is LOCKED (q=0.110058). PCA is fitted on M4 outputs,
#   which are deterministic given the frozen weights. The PCA fit on the
#   same z_t pool is deterministic (svd_solver='full', random_state=42).
#
# RUN (from project root, venv activated)
#   python src/module_12_stage1_steps2_3_4_foundation.py
#
# OUTPUTS (all written by this script)
#   models/M6p5r_zt_pca.pkl               — PCA object (Stage 1.2)
#   models/M6p5r_zt_mean.npy              — z_t mean vector (Stage 1.2)
#   app/runtime/feature_builder.py        — feature module (Stage 1.3)
#   app/runtime/feature_builder_selftest.py — startup validator (Stage 1.4)
#   outputs/reports/module_12_stage1_steps2_3_4_foundation_report.md
#   outputs/reports/module_12_stage1_steps2_3_4_foundation_results.json
# =============================================================================

import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from config import (DEVICE, MODEL_DIR, SYNTH_DIR, OUTPUT_DIR)
from datetime import datetime, date
import json
import pickle
import warnings
warnings.filterwarnings('ignore')

import numpy as np
import torch
import torch.nn as nn
import joblib
from sklearn.decomposition import PCA

SCRIPT_NAME = "module_12_stage1_steps2_3_4_foundation"
REPORT_DIR  = OUTPUT_DIR / "reports"
REPORT_DIR.mkdir(parents=True, exist_ok=True)

# M6.5r PCA config — LOCKED, must match training-time exactly
PCA_N_COMPONENTS  = 2
PCA_RANDOM_STATE  = 42
PCA_SVD_SOLVER    = "full"        # deterministic — no randomized SVD

# Stage 1.2 gate tolerance
TOL_PCA_ROUNDTRIP = 1e-5

# Stage 1.3 gate tolerance (Class A+B identity vs M6B_feature_matrix.csv)
TOL_FEATURE_IDENTITY = 1e-5

# Windows per label for identity tests
WINDOWS_PER_LABEL = 3
TARGET_LABELS     = [0, 1, 3, 4, 5, 7, 10, 13, 15, 18, 21]   # spans all groups

# Channel names — locked from anomaly.py
CHANNEL_NAMES     = ["Mot.SV", "Pmp.SV", "Mot.TV", "Pmp.PV",
                     "Temp.SV", "Pres.SV", "Pmp.TV", "Mot.PV"]
CH_WEIGHTS        = torch.tensor([2.5, 2.5, 0.3, 2.0, 0.5, 2.5, 0.3, 2.0],
                                 dtype=torch.float32)

WINDOW_SIZE = 50   # M4 input window length (locked)


def log(msg):
    print(f"[{datetime.now().strftime('%H:%M:%S')}] {msg}")


def abort(results, reason, _save_fn):
    log(f"  *** ABORT: {reason} ***")
    results["overall_status"] = f"ABORT — {reason}"
    _save_fn(results)
    sys.exit(1)


# =============================================================================
# M4 architecture — exact copy from model_registry.py (standalone)
# =============================================================================
class _M4Encoder(nn.Module):
    def __init__(self):
        super().__init__()
        self.lstm1 = nn.LSTM(8,   128, num_layers=2, batch_first=True)
        self.lstm2 = nn.LSTM(128, 64,  num_layers=1, batch_first=True)
        self.bn    = nn.LayerNorm(64)

    def forward(self, x):
        out1, _      = self.lstm1(x)
        out2, (h, c) = self.lstm2(out1)
        return self.bn(h[-1]), h, c


class _M4Decoder(nn.Module):
    def __init__(self):
        super().__init__()
        self.fc_h  = nn.Linear(64, 128)
        self.fc_c  = nn.Linear(64, 128)
        self.lstm1 = nn.LSTM(64,  128, num_layers=2, batch_first=True)
        self.lstm2 = nn.LSTM(128, 8,   num_layers=1, batch_first=True)
        self.out   = nn.Linear(8, 8)

    def forward(self, z, seq_len, h_enc, c_enc):
        h0    = torch.tanh(self.fc_h(h_enc[-1])).unsqueeze(0).repeat(2, 1, 1)
        c0    = torch.tanh(self.fc_c(c_enc[-1])).unsqueeze(0).repeat(2, 1, 1)
        x_rep = z.unsqueeze(1).repeat(1, seq_len, 1)
        out, _ = self.lstm1(x_rep, (h0, c0))
        out, _ = self.lstm2(out)
        return self.out(out)


class _M4LSTMAutoencoder(nn.Module):
    def __init__(self):
        super().__init__()
        self.encoder = _M4Encoder()
        self.decoder = _M4Decoder()

    def forward(self, x):
        z_t, h, c = self.encoder(x)
        return self.decoder(z_t, x.size(1), h, c)


# =============================================================================
# M4 forward pass — returns z_t and mae_per_ch (same as patched run_m4)
# =============================================================================
@torch.no_grad()
def m4_forward(window_np: np.ndarray, m4_model) -> tuple[np.ndarray, np.ndarray]:
    """Returns (z_t_np [64], mae_per_ch_np [8]) for one [50,8] window."""
    x  = torch.from_numpy(window_np).unsqueeze(0).float()   # [1, 50, 8]
    enc = m4_model.encoder
    out1, _ = enc.lstm1(x)
    out2, (h_n, c_n) = enc.lstm2(out1)
    z_t     = enc.bn(h_n[-1])                               # [1, 64]
    recon   = m4_model.decoder(z_t, x.size(1), h_n, c_n)   # [1, 50, 8]
    mae_per_ch = (x - recon).abs().mean(dim=1).squeeze(0)   # [8]
    return z_t.squeeze(0).cpu().numpy(), mae_per_ch.cpu().numpy()


# =============================================================================
# Helpers — M6B schema
# =============================================================================
def load_m6b(synth_dir: Path) -> tuple[list, list]:
    """Returns (seqs_list, meta_list) — parallel lists, same index."""
    p = synth_dir / "M6B_combined_sequences.pkl"
    with open(p, "rb") as f:
        d = pickle.load(f)
    if isinstance(d, dict) and "sequences" in d and "metadata" in d:
        return d["sequences"], d["metadata"]
    raise ValueError(f"Unrecognised M6B schema: keys={list(d.keys())[:5]}")


def sample_windows(seqs, meta, target_labels, n_per_label):
    """Returns list of (seq_idx, label, window_np[50,8], z_t_np[64], mae_per_ch[8])
       after running M4. Call AFTER m4 is loaded."""
    raise RuntimeError("Call sample_windows_with_m4 instead")


def sample_indices(meta, target_labels, n_per_label):
    """Returns list of (seq_idx, label) — indices only, no M4 yet."""
    result = []
    for tgt in target_labels:
        found = 0
        for i, m in enumerate(meta):
            lbl = int(m.get("label", m.get("label_int", -1)))
            if lbl == tgt:
                result.append((i, tgt))
                found += 1
                if found >= n_per_label:
                    break
        if found == 0:
            log(f"  WARN — no sequences found for label {tgt}")
    return result


# =============================================================================
# STAGE 1.2 — Export z_t PCA
# =============================================================================
def stage_1_2(m4_model, seqs, meta, model_dir, results, _save):
    log("")
    log("=" * 78)
    log("STAGE 1.2 — Export M6.5r z_t PCA")
    log("=" * 78)

    # ── Build z_t pool over a representative sample ──────────────────────────
    # Use first window of every sequence (memory-efficient; deterministic order).
    # M6.5r fitted PCA on all windows from the full training pool — we replicate
    # the same sampling strategy (per-sequence first window) to get an equivalent
    # projection basis. Determinism guaranteed by frozen M4 weights + svd_solver.
    log("Building z_t pool (first window per sequence)...")
    z_t_pool = []
    n_seqs   = len(seqs)
    for i, seq_arr in enumerate(seqs):
        arr = np.asarray(seq_arr, dtype=np.float32)
        if arr.shape[0] < WINDOW_SIZE:
            continue
        window = arr[:WINDOW_SIZE]                         # [50, 8]
        z_t, _ = m4_forward(window, m4_model)
        z_t_pool.append(z_t)
        if (i + 1) % 5000 == 0:
            log(f"  {i+1}/{n_seqs} sequences processed...")

    z_t_pool = np.stack(z_t_pool, axis=0)                 # [N, 64]
    log(f"  z_t pool shape: {z_t_pool.shape}  mean: {z_t_pool.mean():.4f}  std: {z_t_pool.std():.4f}")
    results["stage_1_2"]["z_t_pool_shape"] = list(z_t_pool.shape)

    # ── Centre and fit PCA ────────────────────────────────────────────────────
    mean_zt = z_t_pool.mean(axis=0)                        # [64]
    z_t_centred = z_t_pool - mean_zt

    log(f"Fitting PCA(n_components={PCA_N_COMPONENTS}, svd_solver='{PCA_SVD_SOLVER}')...")
    pca = PCA(n_components=PCA_N_COMPONENTS,
              svd_solver=PCA_SVD_SOLVER,
              random_state=PCA_RANDOM_STATE)
    pca.fit(z_t_centred)
    log(f"  Explained variance ratio: {pca.explained_variance_ratio_}")
    results["stage_1_2"]["explained_variance_ratio"] = pca.explained_variance_ratio_.tolist()

    # ── Save ─────────────────────────────────────────────────────────────────
    pca_path  = model_dir / "M6p5r_zt_pca.pkl"
    mean_path = model_dir / "M6p5r_zt_mean.npy"
    joblib.dump(pca, pca_path)
    np.save(mean_path, mean_zt)
    log(f"  Saved: {pca_path}")
    log(f"  Saved: {mean_path}")
    results["stage_1_2"]["pca_path"]  = str(pca_path)
    results["stage_1_2"]["mean_path"] = str(mean_path)

    # ── Gate: round-trip identity on held-out samples ─────────────────────────
    log("")
    log("Gate 1.2 — PCA round-trip identity (tol=1e-5)...")
    # Use last 200 sequences as held-out (never seen during fit — different indices)
    held_out_indices = list(range(max(0, n_seqs - 200), n_seqs))
    gate_pass = True
    max_diffs = []
    for i in held_out_indices[:20]:    # test 20 samples
        arr = np.asarray(seqs[i], dtype=np.float32)
        if arr.shape[0] < WINDOW_SIZE:
            continue
        z_t, _ = m4_forward(arr[:WINDOW_SIZE], m4_model)
        z_centred = (z_t - mean_zt).reshape(1, -1)

        # Compute features via PCA object
        pca_coords = pca.transform(z_centred)[0]          # [2]
        z_t_norm   = float(np.linalg.norm(z_t - mean_zt))
        # z_t_recon_err: reconstruction error in PCA basis (inverse_transform → diff)
        z_reconstructed = pca.inverse_transform(pca_coords.reshape(1, -1))[0] + mean_zt
        z_t_recon_err   = float(np.linalg.norm(z_t - z_reconstructed))

        # Reference: compute directly without PCA object (manual dot product)
        components = pca.components_           # [2, 64]
        pca_coords_ref  = z_centred @ components.T          # [1, 2]
        z_recon_ref     = (pca_coords_ref @ components) + mean_zt   # [1, 64]
        recon_err_ref   = float(np.linalg.norm(z_t - z_recon_ref[0]))

        diff_pca1  = abs(float(pca_coords[0]) - float(pca_coords_ref[0, 0]))
        diff_pca2  = abs(float(pca_coords[1]) - float(pca_coords_ref[0, 1]))
        diff_norm  = abs(z_t_norm - float(np.linalg.norm((z_t - mean_zt))))
        diff_err   = abs(z_t_recon_err - recon_err_ref)
        mx = max(diff_pca1, diff_pca2, diff_norm, diff_err)
        max_diffs.append(mx)
        ok = mx < TOL_PCA_ROUNDTRIP
        if not ok:
            gate_pass = False
        log(f"  held-out idx={i}  max_diff={mx:.2e}  [{'PASS' if ok else 'FAIL'}]")

    gate_max = max(max_diffs) if max_diffs else 0.0
    results["stage_1_2"]["gate_max_diff"]  = gate_max
    results["stage_1_2"]["gate_pass"]      = gate_pass
    log(f"  Gate 1.2 max diff: {gate_max:.2e}  [{'PASS' if gate_pass else 'FAIL'}]")

    if not gate_pass:
        abort(results, "Stage 1.2 gate FAIL — PCA round-trip exceeds 1e-5", _save)

    log("  Gate 1.2: PASS — PCA saved and verified.")
    return pca, mean_zt


# =============================================================================
# STAGE 1.3 — Write app/runtime/feature_builder.py
# =============================================================================
def stage_1_3(m4_model, seqs, meta, pca, mean_zt, model_dir, results, _save):
    log("")
    log("=" * 78)
    log("STAGE 1.3 — Write app/runtime/feature_builder.py")
    log("=" * 78)

    # ── Determine output path ────────────────────────────────────────────────
    # feature_builder.py goes into app/runtime/ in the project root.
    # This script is in src/ — project root is one level up.
    project_root     = Path(__file__).resolve().parent.parent
    runtime_dir      = project_root / "app" / "runtime"
    runtime_dir.mkdir(parents=True, exist_ok=True)
    fb_path          = runtime_dir / "feature_builder.py"

    log(f"Writing {fb_path}...")

    # ── Validate our own feature computation against M4 (pre-write check) ────
    # Compute Class A+B for a few samples before writing the file.
    # This validates the formula, not just the file content.
    log("Pre-write validation: computing Class A+B features on sample windows...")
    sample_idxs = sample_indices(meta, TARGET_LABELS, WINDOWS_PER_LABEL)
    gate_samples = []

    for seq_idx, lbl in sample_idxs:
        arr = np.asarray(seqs[seq_idx], dtype=np.float32)
        if arr.shape[0] < WINDOW_SIZE:
            continue
        window = arr[:WINDOW_SIZE]
        z_t_np, mae_per_ch_np = m4_forward(window, m4_model)

        # Class A
        feat_0_7  = mae_per_ch_np.copy()                          # [8]
        feat_8_15 = np.log1p(mae_per_ch_np)                       # [8]
        # Class B
        z_centred  = (z_t_np - mean_zt).reshape(1, -1)
        pca_coords = pca.transform(z_centred)[0]                  # [2]
        z_t_norm   = float(np.linalg.norm(z_t_np - mean_zt))
        z_recon    = pca.inverse_transform(pca_coords.reshape(1,-1))[0] + mean_zt
        z_t_recon_err = float(np.linalg.norm(z_t_np - z_recon))

        gate_samples.append({
            "seq_idx"       : seq_idx,
            "label"         : lbl,
            "feat_0_7"      : feat_0_7.tolist(),
            "feat_8_15"     : feat_8_15.tolist(),
            "z_t_pca_1"     : float(pca_coords[0]),
            "z_t_pca_2"     : float(pca_coords[1]),
            "z_t_norm"      : z_t_norm,
            "z_t_recon_err" : z_t_recon_err,
        })

    log(f"  Pre-write computed {len(gate_samples)} sample windows — OK")
    results["stage_1_3"]["pre_write_sample_count"] = len(gate_samples)

    if len(gate_samples) == 0:
        abort(results, "Stage 1.3 pre-write: no sample windows computed", _save)

    # ── Write feature_builder.py ──────────────────────────────────────────────
    pca_pkl_rel  = "models/M6p5r_zt_pca.pkl"
    mean_npy_rel = "models/M6p5r_zt_mean.npy"

    fb_source = '''# =============================================================================
# app/runtime/feature_builder.py
#
# Single source of truth for the 33-feature M7 input vector.
# Generated by src/module_12_stage1_steps2_3_4_foundation.py (Stage 1.3).
# DO NOT EDIT manually — regenerate via the Stage 1 foundation script.
#
# 33-feature schema (M6.5r column order — LOCKED):
#   Class A  indices  0-7   : per-channel M4 reconstruction MAE
#            indices  8-15  : log1p(mae_per_ch) — log-scaled variant
#   Class B  indices 16-19  : z_t PCA projections
#              16: z_t_pca_1      — first principal component score
#              17: z_t_pca_2      — second principal component score
#              18: z_t_norm       — L2 norm of centred z_t
#              19: z_t_recon_err  — reconstruction error in PCA basis
#   Class D  indices 20-28  : sequence-aware features — STUBBED 0.0 (Stage 2)
#   Class C  indices 29-31  : score_A, score_B, score_C (direct model outputs)
#   Class D  index   32     : severity_score — STUBBED 0.0 (Stage 2)
#
# D1a fix: indices 0-7 are the TRUE M4 reconstruction error per channel,
# not the broken MAD-of-raw-window that was deployed pre-Stage-1.1.
# Stage 1.1 identity test verified bit-exact agreement (max_abs_diff < 1e-7).
# =============================================================================

from pathlib import Path
import numpy as np
import joblib
import logging

logger = logging.getLogger("pumpsmart.feature_builder")

# ── Load PCA artifacts at module import time ──────────────────────────────────
# Paths are relative to project root (where config.py lives).
_PROJECT_ROOT = Path(__file__).resolve().parent.parent.parent
_PCA_PATH     = _PROJECT_ROOT / "''' + pca_pkl_rel + '''"
_MEAN_PATH    = _PROJECT_ROOT / "''' + mean_npy_rel + '''"

_pca     = None
_mean_zt = None

def _load_pca_artifacts():
    global _pca, _mean_zt
    if _pca is not None:
        return   # already loaded
    try:
        _pca     = joblib.load(_PCA_PATH)
        _mean_zt = np.load(_MEAN_PATH)
        logger.info(f"[feature_builder] PCA loaded from {_PCA_PATH}")
    except Exception as e:
        raise RuntimeError(
            f"[feature_builder] Cannot load PCA artifacts: {e}\\n"
            f"  Expected: {_PCA_PATH}\\n"
            f"  Run src/module_12_stage1_steps2_3_4_foundation.py to generate them."
        )


# ── Feature column names (canonical order — LOCKED) ──────────────────────────
FEATURE_COLS_M7 = [
    # Class A — M4 per-channel reconstruction MAE (indices 0-7)
    "mae_MotSV", "mae_PmpSV", "mae_MotTV", "mae_PmpPV",
    "mae_TempSV", "mae_PresSV", "mae_PmpTV", "mae_MotPV",
    # Class A — log1p-scaled MAE (indices 8-15)
    "log_mae_MotSV", "log_mae_PmpSV", "log_mae_MotTV", "log_mae_PmpPV",
    "log_mae_TempSV", "log_mae_PresSV", "log_mae_PmpTV", "log_mae_MotPV",
    # Class B — z_t PCA features (indices 16-19)
    "z_t_pca_1", "z_t_pca_2", "z_t_norm", "z_t_recon_err",
    # Class D — sequence-aware (indices 20-28), stubbed Stage 2
    "masked_channel_flag", "multi_sensor_anomaly_count",
    "burst_count", "cyclic_baseline_drift", "variant_slope_ratio",
    "thermal_decoupling_flag", "onset_order",
    "secondary_onset_lag",   # C-29 deferred — permanently 0.0
    "fault_group_id",
    # Class C — direct model outputs (indices 29-31)
    "score_A", "score_B", "score_C",
    # Class D — severity (index 32), stubbed Stage 2
    "severity_score",
]
assert len(FEATURE_COLS_M7) == 33, f"Schema drift: {len(FEATURE_COLS_M7)} cols"


# ── Public API ────────────────────────────────────────────────────────────────

def build_m7_features(
    mae_per_ch_np: np.ndarray,   # [8]  — from patched run_m4 (D1a fix)
    z_t_np:        np.ndarray,   # [64] — encoder bottleneck from run_m4
    score_A:       float,
    score_B:       float,
    score_C:       float,
) -> np.ndarray:
    """
    Returns the 33-feature vector in canonical FEATURE_COLS_M7 order.
    Class D features are 0.0 stubs — Stage 2 will replace them with
    calibrated runtime proxies without changing this function's signature.

    Args:
        mae_per_ch_np : per-channel M4 reconstruction MAE [8] — D1a fix
        z_t_np        : M4 encoder bottleneck [64]
        score_A       : physics-weighted MAE scalar (L1 output)
        score_B       : TCN-AE drift slope (L2 output, 0.0 if buffer not ready)
        score_C       : TCN-AE chain transition (L2 output, 0.0 if buffer not ready)
    """
    _load_pca_artifacts()

    feats = np.zeros(33, dtype=np.float32)

    # Class A — indices 0-7: true M4 reconstruction error per channel
    feats[0:8] = mae_per_ch_np

    # Class A — indices 8-15: log1p-scaled MAE (stabilises near-zero values)
    feats[8:16] = np.log1p(mae_per_ch_np)

    # Class B — indices 16-19: z_t PCA features
    z_centred       = (z_t_np - _mean_zt).reshape(1, -1)       # [1, 64]
    pca_coords      = _pca.transform(z_centred)[0]              # [2]
    z_t_norm        = float(np.linalg.norm(z_t_np - _mean_zt))
    z_reconstructed = _pca.inverse_transform(
                          pca_coords.reshape(1, -1))[0] + _mean_zt   # [64]
    z_t_recon_err   = float(np.linalg.norm(z_t_np - z_reconstructed))

    feats[16] = float(pca_coords[0])    # z_t_pca_1
    feats[17] = float(pca_coords[1])    # z_t_pca_2
    feats[18] = z_t_norm                # z_t_norm
    feats[19] = z_t_recon_err           # z_t_recon_err

    # Class D — indices 20-28, 32: sequence-aware stubs (Stage 2)
    # masked_channel_flag=0, multi_sensor_anomaly_count=0, burst_count=0,
    # cyclic_baseline_drift=0, variant_slope_ratio=0, thermal_decoupling_flag=0,
    # onset_order=0, secondary_onset_lag=0 (C-29 deferred), fault_group_id=0
    feats[20:29] = 0.0
    feats[32]    = 0.0   # severity_score

    # Class C — indices 29-31: direct model score pass-through
    feats[29] = float(score_A)
    feats[30] = float(score_B)
    feats[31] = float(score_C)

    return feats
'''

    with open(fb_path, "w", encoding="utf-8") as f:
        f.write(fb_source)
    log(f"  Written: {fb_path}")
    results["stage_1_3"]["feature_builder_path"] = str(fb_path)

    # ── Gate 1.3: import and verify Class A+B identity ────────────────────────
    log("")
    log("Gate 1.3 — Class A+B identity vs computed reference (tol=1e-5)...")

    # Dynamically import the just-written module
    import importlib.util
    spec = importlib.util.spec_from_file_location("feature_builder", fb_path)
    fb   = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(fb)

    gate_pass     = True
    max_diffs_A   = []
    max_diffs_B   = []

    for s in gate_samples:
        seq_idx  = s["seq_idx"]
        arr      = np.asarray(seqs[seq_idx], dtype=np.float32)
        window   = arr[:WINDOW_SIZE]
        z_t_np, mae_per_ch_np = m4_forward(window, m4_model)

        feat_vec = fb.build_m7_features(
            mae_per_ch_np, z_t_np, 0.0, 0.0, 0.0
        )   # score_A/B/C=0 — not part of gate

        # Class A diff (indices 0-15)
        ref_A = np.concatenate([
            np.array(s["feat_0_7"],  dtype=np.float32),
            np.array(s["feat_8_15"], dtype=np.float32),
        ])
        diff_A = float(np.abs(feat_vec[0:16] - ref_A).max())

        # Class B diff (indices 16-19)
        ref_B = np.array([
            s["z_t_pca_1"], s["z_t_pca_2"],
            s["z_t_norm"],  s["z_t_recon_err"],
        ], dtype=np.float32)
        diff_B = float(np.abs(feat_vec[16:20] - ref_B).max())

        mx_AB = max(diff_A, diff_B)
        ok    = mx_AB < TOL_FEATURE_IDENTITY
        if not ok:
            gate_pass = False
        max_diffs_A.append(diff_A)
        max_diffs_B.append(diff_B)

        log(f"  seq={seq_idx:>5}  lbl={s['label']:>2}  "
            f"diff_A={diff_A:.2e}  diff_B={diff_B:.2e}  "
            f"[{'PASS' if ok else 'FAIL'}]")

    gate_max_A = max(max_diffs_A) if max_diffs_A else 0.0
    gate_max_B = max(max_diffs_B) if max_diffs_B else 0.0
    results["stage_1_3"]["gate_max_diff_A"] = gate_max_A
    results["stage_1_3"]["gate_max_diff_B"] = gate_max_B
    results["stage_1_3"]["gate_pass"]       = gate_pass

    log(f"  Gate 1.3: Class A max_diff={gate_max_A:.2e}  "
        f"Class B max_diff={gate_max_B:.2e}  "
        f"[{'PASS' if gate_pass else 'FAIL'}]")

    if not gate_pass:
        abort(results, "Stage 1.3 gate FAIL — feature identity exceeds 1e-5", _save)

    log("  Gate 1.3: PASS — feature_builder.py written and verified.")
    return fb_path, gate_samples


# =============================================================================
# STAGE 1.4 — Write app/runtime/feature_builder_selftest.py
# =============================================================================
def stage_1_4(m4_model, seqs, meta, model_dir, fb_path, gate_samples,
              results, _save):
    log("")
    log("=" * 78)
    log("STAGE 1.4 — Write feature_builder_selftest.py + simulate mismatch")
    log("=" * 78)

    project_root = Path(__file__).resolve().parent.parent
    runtime_dir  = project_root / "app" / "runtime"
    st_path      = runtime_dir / "feature_builder_selftest.py"

    log(f"Writing {st_path}...")

    # Build the ground-truth reference dict that the selftest will use.
    # Keys: seq_idx, values: feat[0:20] as list (Class A+B only — deterministic)
    # This is embedded in the selftest module so it requires no external CSV.
    ref_rows = []
    for s in gate_samples[:20]:   # cap at 20 for startup speed
        ref_rows.append({
            "seq_idx"  : s["seq_idx"],
            "label"    : s["label"],
            "feat_0_19": (
                s["feat_0_7"] + s["feat_8_15"] +
                [s["z_t_pca_1"], s["z_t_pca_2"],
                 s["z_t_norm"],  s["z_t_recon_err"]]
            ),
        })

    ref_json = json.dumps(ref_rows, indent=2)

    st_source = '''# =============================================================================
# app/runtime/feature_builder_selftest.py
#
# Startup identity assertion for feature_builder.py.
# Generated by src/module_12_stage1_steps2_3_4_foundation.py (Stage 1.4).
# Called by model_registry.load_all_models() at server startup.
#
# If any Class A or B feature deviates by more than TOL from the reference
# values embedded here, the function raises RuntimeError and the server
# refuses to start. This enforces C-30 in code.
# =============================================================================

import numpy as np
import pickle
import torch
import torch.nn as nn
from pathlib import Path
import logging

logger = logging.getLogger("pumpsmart.feature_builder_selftest")

TOL_SELFTEST = 1e-5
WINDOW_SIZE  = 50

# Reference ground-truth (Class A+B, indices 0-19) embedded at generation time.
# Regenerate by re-running src/module_12_stage1_steps2_3_4_foundation.py.
_REFERENCE_ROWS = ''' + ref_json + '''


# ── Inline M4 architecture (copy from model_registry — selftest is standalone)
class _M4Encoder(nn.Module):
    def __init__(self):
        super().__init__()
        self.lstm1 = nn.LSTM(8, 128, num_layers=2, batch_first=True)
        self.lstm2 = nn.LSTM(128, 64, num_layers=1, batch_first=True)
        self.bn    = nn.LayerNorm(64)
    def forward(self, x):
        out1, _ = self.lstm1(x)
        out2, (h, c) = self.lstm2(out1)
        return self.bn(h[-1]), h, c

class _M4Decoder(nn.Module):
    def __init__(self):
        super().__init__()
        self.fc_h  = nn.Linear(64, 128)
        self.fc_c  = nn.Linear(64, 128)
        self.lstm1 = nn.LSTM(64, 128, num_layers=2, batch_first=True)
        self.lstm2 = nn.LSTM(128, 8, num_layers=1, batch_first=True)
        self.out   = nn.Linear(8, 8)
    def forward(self, z, seq_len, h_enc, c_enc):
        h0 = torch.tanh(self.fc_h(h_enc[-1])).unsqueeze(0).repeat(2,1,1)
        c0 = torch.tanh(self.fc_c(c_enc[-1])).unsqueeze(0).repeat(2,1,1)
        x_rep = z.unsqueeze(1).repeat(1, seq_len, 1)
        out, _ = self.lstm1(x_rep, (h0, c0))
        out, _ = self.lstm2(out)
        return self.out(out)

class _M4LSTMAutoencoder(nn.Module):
    def __init__(self):
        super().__init__()
        self.encoder = _M4Encoder()
        self.decoder = _M4Decoder()
    def forward(self, x):
        z_t, h, c = self.encoder(x)
        return self.decoder(z_t, x.size(1), h, c)


@torch.no_grad()
def _m4_forward(window_np, m4_model):
    x = torch.from_numpy(window_np).unsqueeze(0).float()
    enc = m4_model.encoder
    out1, _ = enc.lstm1(x)
    out2, (h_n, c_n) = enc.lstm2(out1)
    z_t   = enc.bn(h_n[-1])
    recon = m4_model.decoder(z_t, x.size(1), h_n, c_n)
    mae_per_ch = (x - recon).abs().mean(dim=1).squeeze(0)
    return z_t.squeeze(0).cpu().numpy(), mae_per_ch.cpu().numpy()


def run_startup_selftest(m4_model, seqs_list: list, meta_list: list) -> None:
    """
    Called from model_registry.load_all_models() after all models are loaded.
    Raises RuntimeError if feature_builder output deviates from reference.
    seqs_list / meta_list: the M6B parallel arrays (already loaded by registry).
    """
    import sys as _sys
    fb = _sys.modules.get("app.runtime.feature_builder")
    if fb is None:
        from app.runtime import feature_builder as fb

    logger.info("[selftest] Starting feature_builder startup identity assertion...")
    failed = []

    for row in _REFERENCE_ROWS:
        seq_idx = row["seq_idx"]
        ref     = np.array(row["feat_0_19"], dtype=np.float32)   # [20]

        arr = np.asarray(seqs_list[seq_idx], dtype=np.float32)
        if arr.shape[0] < WINDOW_SIZE:
            logger.warning(f"[selftest] seq_idx={seq_idx} too short, skip")
            continue

        window = arr[:WINDOW_SIZE]
        z_t_np, mae_per_ch_np = _m4_forward(window, m4_model)
        feat_vec = fb.build_m7_features(mae_per_ch_np, z_t_np, 0.0, 0.0, 0.0)

        diff = float(np.abs(feat_vec[0:20] - ref).max())
        if diff >= TOL_SELFTEST:
            failed.append({
                "seq_idx" : seq_idx,
                "label"   : row["label"],
                "max_diff": diff,
            })
            logger.error(
                f"[selftest] MISMATCH seq={seq_idx} label={row['label']} "
                f"max_diff={diff:.2e} >= tol={TOL_SELFTEST:.0e}"
            )

    if failed:
        raise RuntimeError(
            f"[feature_builder_selftest] STARTUP ABORT — "
            f"{len(failed)} windows exceed identity tolerance {TOL_SELFTEST:.0e}.\\n"
            f"First failure: {failed[0]}\\n"
            f"Re-run src/module_12_stage1_steps2_3_4_foundation.py to regenerate "
            f"feature_builder.py and its reference embeddings."
        )

    logger.info(
        f"[selftest] PASS — {len(_REFERENCE_ROWS)} windows verified, "
        f"all Class A+B features within tol={TOL_SELFTEST:.0e}"
    )
'''

    with open(st_path, "w", encoding="utf-8") as f:
        f.write(st_source)
    log(f"  Written: {st_path}")
    results["stage_1_4"]["selftest_path"] = str(st_path)

    # ── Gate 1.4a: clean run passes ──────────────────────────────────────────
    log("Gate 1.4a — selftest passes on clean environment...")
    import importlib.util
    spec = importlib.util.spec_from_file_location("feature_builder_selftest", st_path)
    st   = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(st)

    seqs_list, meta_list = seqs, meta
    try:
        st.run_startup_selftest(m4_model, seqs_list, meta_list)
        log("  Gate 1.4a: PASS — clean environment selftest passed.")
        results["stage_1_4"]["gate_1_4a_pass"] = True
    except RuntimeError as e:
        log(f"  Gate 1.4a: FAIL — {e}")
        results["stage_1_4"]["gate_1_4a_pass"] = False
        abort(results, "Stage 1.4a gate FAIL — selftest failed on clean env", _save)

    # ── Gate 1.4b: simulated mismatch triggers RuntimeError ──────────────────
    log("Gate 1.4b — simulated mismatch triggers abort...")
    #
    # Root-cause of previous failure: st.run_startup_selftest() does
    #   from app.runtime import feature_builder as fb
    # at call time. Replacing sys.modules["app.runtime.feature_builder"] AFTER
    # the module was already loaded had no effect because Python resolves the
    # import from cache and binds the name immediately — the local `fb` inside
    # run_startup_selftest already points to the real object.
    #
    # Correct approach: locate the feature_builder module object that st will
    # actually use (via sys.modules or a fresh import), then temporarily replace
    # its build_m7_features attribute in-place. Restore in finally.
    import sys as _sys
    import importlib

    # Ensure app.runtime.feature_builder is in sys.modules (it should be from 1.4a)
    fb_mod = _sys.modules.get("app.runtime.feature_builder")
    if fb_mod is None:
        # Fallback: import it properly so the module cache is populated
        import importlib.util as ilu
        spec_fb = ilu.spec_from_file_location(
            "app.runtime.feature_builder", fb_path,
            submodule_search_locations=[]
        )
        fb_mod = ilu.module_from_spec(spec_fb)
        spec_fb.loader.exec_module(fb_mod)
        _sys.modules["app.runtime.feature_builder"] = fb_mod

    # Save original function; patch attribute on the live module object
    orig_fn = fb_mod.build_m7_features

    def _poisoned(*args, **kwargs):
        feats = orig_fn(*args, **kwargs)
        feats[0:8] += 999.0   # corrupt Class A by +999 — guaranteed diff > tol
        return feats

    mismatch_triggered = False
    try:
        fb_mod.build_m7_features = _poisoned          # patch live object in-place
        st.run_startup_selftest(m4_model, seqs_list, meta_list)
    except RuntimeError:
        mismatch_triggered = True
    finally:
        fb_mod.build_m7_features = orig_fn            # always restore

    results["stage_1_4"]["gate_1_4b_pass"] = mismatch_triggered
    if mismatch_triggered:
        log("  Gate 1.4b: PASS — RuntimeError raised on simulated mismatch.")
    else:
        log("  Gate 1.4b: FAIL — mismatch NOT detected.")
        abort(results, "Stage 1.4b gate FAIL — mismatch not detected", _save)

    log("  Stage 1.4: COMPLETE.")


# =============================================================================
# SAVE + REPORT
# =============================================================================
def _save(results):
    rp = REPORT_DIR / f"{SCRIPT_NAME}_report.md"
    jp = REPORT_DIR / f"{SCRIPT_NAME}_results.json"
    with open(rp, "w", encoding="utf-8") as f:
        f.write(f"# {SCRIPT_NAME}\n\n")
        f.write(f"- Timestamp: {results.get('timestamp')}\n")
        f.write(f"- Status: **{results.get('overall_status')}**\n\n")
        for stage in ["stage_1_2", "stage_1_3", "stage_1_4"]:
            f.write(f"## {stage}\n\n")
            for k, v in results.get(stage, {}).items():
                f.write(f"- {k}: {v}\n")
            f.write("\n")
    with open(jp, "w", encoding="utf-8") as f:
        json.dump(results, f, indent=2, default=str)


# =============================================================================
# MAIN
# =============================================================================
def main():
    log(f"==== {SCRIPT_NAME} ====")
    log(f"Date: {date.today().isoformat()}")
    log("Stage 1.1 MUST be complete (anomaly.py patched) before running this.")
    log("")

    results = {
        "script"         : SCRIPT_NAME,
        "timestamp"      : datetime.now().isoformat(),
        "overall_status" : "UNKNOWN",
        "stage_1_2"      : {},
        "stage_1_3"      : {},
        "stage_1_4"      : {},
    }

    # ── Load M4 (locked — do not retrain) ─────────────────────────────────────
    log("Loading M4 LSTM-AE checkpoint (locked, map_location=cpu)...")
    try:
        m4_path  = MODEL_DIR / "lstm_ae_baseline_final.pth"
        m4_model = _M4LSTMAutoencoder()
        state    = torch.load(m4_path, map_location="cpu", weights_only=False)
        sd       = state.get("model_state_dict", state) if isinstance(state, dict) else state
        m4_model.load_state_dict(sd)
        m4_model.eval()
        log(f"  OK — {m4_path}")
    except Exception as e:
        abort(results, f"M4 load failed: {e}", _save)

    # ── Load M6B ──────────────────────────────────────────────────────────────
    log("Loading M6B_combined_sequences.pkl...")
    try:
        seqs, meta = load_m6b(SYNTH_DIR)
        log(f"  OK — {len(seqs)} sequences")
    except Exception as e:
        abort(results, f"M6B load failed: {e}", _save)

    # ── STAGE 1.2 ─────────────────────────────────────────────────────────────
    pca, mean_zt = stage_1_2(m4_model, seqs, meta, MODEL_DIR, results, _save)

    # ── STAGE 1.3 ─────────────────────────────────────────────────────────────
    fb_path, gate_samples = stage_1_3(
        m4_model, seqs, meta, pca, mean_zt, MODEL_DIR, results, _save
    )

    # ── STAGE 1.4 ─────────────────────────────────────────────────────────────
    stage_1_4(m4_model, seqs, meta, MODEL_DIR, fb_path, gate_samples, results, _save)

    # ── Final status ──────────────────────────────────────────────────────────
    results["overall_status"] = "PASS"
    _save(results)

    log("")
    log("=" * 78)
    log("ALL STAGES PASS — Stage 1 Foundation complete.")
    log("  models/M6p5r_zt_pca.pkl              written and verified")
    log("  models/M6p5r_zt_mean.npy             written and verified")
    log("  app/runtime/feature_builder.py       written and verified")
    log("  app/runtime/feature_builder_selftest.py  written and verified")
    log("=" * 78)

    # ── NEXT: wire feature_builder into anomaly.py and model_registry.py ─────
    log("")
    log("NEXT ACTIONS (manual — do NOT skip):")
    log("  1. In app/routers/anomaly.py — replace _build_m7_features call with:")
    log("       from app.runtime.feature_builder import build_m7_features")
    log("       feature_vec = build_m7_features(mae_per_ch_np, z_t_np,")
    log("                                        score_A, score_B, score_C)")
    log("  2. In app/runtime/model_registry.py — at end of load_all_models():")
    log("       from app.runtime.feature_builder_selftest import run_startup_selftest")
    log("       run_startup_selftest(models['m4_model'], seqs_list, meta_list)")
    log("  3. Restart server and confirm startup log shows [selftest] PASS.")

    print()
    print("══ PASTE TEXT UPDATE — COPY BELOW INTO PASTE TEXT ══")
    print(f"M12 Stage 1.2 (PCA export):          PASS")
    print(f"  M6p5r_zt_pca.pkl saved and verified")
    print(f"  Gate max_diff: {results['stage_1_2'].get('gate_max_diff', 'n/a'):.2e}")
    print(f"M12 Stage 1.3 (feature_builder.py):  PASS")
    print(f"  Class A max_diff: {results['stage_1_3'].get('gate_max_diff_A', 'n/a'):.2e}")
    print(f"  Class B max_diff: {results['stage_1_3'].get('gate_max_diff_B', 'n/a'):.2e}")
    print(f"M12 Stage 1.4 (startup self-test):   PASS")
    print(f"  Gate 1.4a (clean run): {results['stage_1_4'].get('gate_1_4a_pass')}")
    print(f"  Gate 1.4b (mismatch detected): {results['stage_1_4'].get('gate_1_4b_pass')}")
    print(f"D1a status: PARTIALLY RESOLVED — Class A+B correct, Class D stubbed")
    print(f"Next: wire feature_builder into anomaly.py + model_registry.py (see NEXT ACTIONS above)")
    print(f"Then: Stage 2 — Class D runtime proxies")
    print(f"BLOCK_M11 = True")
    print("══ END PASTE UPDATE ══")

    print()
    print("══ FILE MANIFEST ══")
    print(f"  GitHub push (new files):")
    print(f"    models/M6p5r_zt_pca.pkl")
    print(f"    models/M6p5r_zt_mean.npy")
    print(f"    app/runtime/feature_builder.py")
    print(f"    app/runtime/feature_builder_selftest.py")
    print(f"    src/{SCRIPT_NAME}.py")
    print(f"  Reports (Spaces upload):")
    print(f"    outputs/reports/{SCRIPT_NAME}_report.md")
    print(f"    outputs/reports/{SCRIPT_NAME}_results.json")


if __name__ == "__main__":
    main()